# Copy to .env and fill in. Never commit .env.
PORT=8080
# SQLite database file (inside Docker: /data/ltmgh.sqlite on the mounted volume)
DB_PATH=./var/ltmgh.sqlite
# "Forgot password" e-mails via resend.com (domain verified there). Leave empty to disable self-service reset.
RESEND_API_KEY=
MAIL_FROM=Zuna Hotel Desk <noreply@zuna.ai>
# Canonical host name; other *.zuna.ai names pointing here 301-redirect to it. Leave empty to disable.
PRIMARY_HOST=
# 1 = trust X-Forwarded-Proto / X-Forwarded-Host from the reverse proxy (default). Set 0 if exposed directly.
TRUST_PROXY=1
# Local testing only (plain http on a non-localhost name). Never in production.
INSECURE_COOKIES=0
